# ---- Server ----
PORT=5000
NODE_ENV=development
# Origin of the React app (used for CORS). No trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL (8.0.16+ or MariaDB 10.2+) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codealpha_app

# ---- JWT ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Used ONLY by `npm run db:seed` ----
# Becomes the password of every sample account (demo.customer@example.com, ana.rivera@example.com, ...).
# Needs 8+ characters with a letter and a number. Leave empty to skip sample accounts.
SEED_DEMO_PASSWORD=

# ---- Used ONLY by `npm run admin:create` (or you will be prompted) ----
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
