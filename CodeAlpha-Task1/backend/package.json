{
  "name": "codealpha-store-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + MySQL API for the CodeAlpha e-commerce store (Task 1)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node database/scripts/init.js",
    "db:reset": "node database/scripts/init.js --reset",
    "db:seed": "node database/scripts/seed.js",
    "admin:create": "node database/scripts/create-admin.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.11.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
